# Database — for Docker, use the postgres service name as host
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/zun_cms

# Payload — generate a long random string for production
PAYLOAD_SECRET=super-secret-change-in-production

# The public URL this app is served at (used by Payload for media URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# On-demand revalidation for the website (leave blank to disable)
REVALIDATE_URL=
REVALIDATE_SECRET=

# Required by docker-compose — password for the Postgres Docker container
POSTGRES_PASSWORD=

# Seed script — initial admin account credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Production overrides (docker-compose.yml reads these from .env on VPS) ──
# DATABASE_URI=postgresql://postgres:<PROD_POSTGRES_PASSWORD>@postgres:5432/zun_cms
# POSTGRES_PASSWORD=<strong-random-password>
# PAYLOAD_SECRET=<strong-random-string>
# NEXT_PUBLIC_SERVER_URL=https://admin-cms.zunkireelabs.com
# REVALIDATE_URL=https://cms-dev.zunkireelabs.com
# REVALIDATE_SECRET=<matching-secret-from-website>
